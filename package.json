{
  "name": "reckon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An Instagram-style infinite feed of bite-sized knowledge from many fields.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --mode lesefutter",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "content": "node scripts/content.ts",
    "mcp": "node mcp/index.ts",
    "mcp:http": "node mcp/index.ts --http",
    "clip": "node scripts/clip.ts",
    "explainer": "node scripts/explainer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
